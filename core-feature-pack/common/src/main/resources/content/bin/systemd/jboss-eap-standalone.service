[Unit]
Description=JBoss EAP (standalone mode)
After=syslog.target network.target
Before=httpd.service

[Service]
Environment=LAUNCH_JBOSS_IN_BACKGROUND=1
Environment="JAVA_HOME=/usr/lib/jvm/jre"

Environment="JBOSS_EAP_SH=/opt/eap/bin/standalone.sh"
Environment="JBOSS_EAP_SERVER_CONFIG=standalone.xml"
Environment="JBOSS_EAP_CONSOLE_LOG=/opt/eap/standalone/log/systemd-console.log"
Environment="JBOSS_EAP_BIND=0.0.0.0"
EnvironmentFile=-/etc/sysconfig/jboss-eap-standalone.conf

User=jbosseap
Group=jbosseap
LimitNOFILE=102642
ExecStart=/bin/sh -c "/opt/eap/bin/systemd/launch.sh"
TimeoutSec=600

[Install]
WantedBy=multi-user.target
